<Project Sdk="Microsoft.NET.Sdk">

  <!--The stub in BepInEx\plugins finds Keel and startup preparation DLLs in enabled mod folders.-->
  <PropertyGroup>
    <AssemblyName>SeaPowerKeel.Stub</AssemblyName>
    <RootNamespace>SeaPowerKeel.Stub</RootNamespace>
    <Product>R.A.T.S. Keel stub: starts the Keel mod loader from the game's mod folders.</Product>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SeaPowerKeel\ModFolders.cs" Link="ModFolders.cs" />
    <Compile Include="..\SeaPowerKeel\InfoVersion.cs" Link="InfoVersion.cs" />
    <Compile Include="..\SeaPowerKeel\PreparationDll.cs" Link="PreparationDll.cs" />
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
