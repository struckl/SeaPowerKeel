<Project Sdk="Microsoft.NET.Sdk">

  <!--The loader, shipped through the Workshop. Started by the stub (SeaPowerKeel.Stub.dll in BepInEx\plugins).-->
  <PropertyGroup>
    <AssemblyName>SeaPowerKeel</AssemblyName>
    <RootNamespace>SeaPowerKeel</RootNamespace>
    <Product>R.A.T.S. Keel: a mod loader for Sea Power that checks every mod against the running game before it starts it.</Product>
    <Version>0.1.1</Version>
    <!--Local mod folder for testing: the game lists every StreamingAssets sub folder as a mod.-->
    <ModDeployDir>$(GameDir)\Sea Power_Data\StreamingAssets\SeaPowerKeel</ModDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SeaPowerKeel.OfflineCheck" />
  </ItemGroup>

  <ItemGroup>
    <ModFiles Include="mod\**\*.*" />
  </ItemGroup>

  <!--Only with -p:Deploy=true: the game is his, and a DLL dropped into its mod folders starts with his next game.-->
  <Target Name="DeployMod" AfterTargets="Build" Condition="Exists('$(GameDir)') And '$(Deploy)' == 'true'">
    <MakeDir Directories="$(ModDeployDir)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(ModDeployDir)" />
    <Copy SourceFiles="@(ModFiles)" DestinationFolder="$(ModDeployDir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="SeaPowerKeel deployed to $(ModDeployDir)" />
  </Target>

</Project>
