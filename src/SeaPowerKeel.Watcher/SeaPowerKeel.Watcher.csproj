<Project Sdk="Microsoft.NET.Sdk">

  <!-- KeelWatcher.exe: shows the crash window from outside the game. .NET Framework 4.8: on every Windows 10 and 11. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>KeelWatcher</AssemblyName>
    <Product>R.A.T.S. Keel</Product>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\SeaPowerKeel\SeaPowerKeel.csproj')), '&lt;Version&gt;(.+?)&lt;/Version&gt;').Groups[1].Value)</Version>
    <RootNamespace>SeaPowerKeel</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SeaPowerKeel\CrashText.cs" Link="CrashText.cs" />
    <Compile Include="..\SeaPowerKeel\ReportFacts.cs" Link="ReportFacts.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
