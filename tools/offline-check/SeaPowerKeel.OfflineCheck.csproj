<Project Sdk="Microsoft.NET.Sdk">

  <!--Runs Keel's scanner, game-version check and planner over mod folders on disk, outside the game:
        dotnet run -c Release -p:GameBuild=globe|flat   (see Program.cs)-->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>SeaPowerKeel.OfflineCheck</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">E:\Games\steamapps\common\Sea Power</GameDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SeaPowerKeel\SeaPowerKeel.csproj" />
    <Compile Include="..\..\src\SeaPowerKeel.Setup\SetupCore.cs" Link="SetupCore.cs" />
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath></Reference>
  </ItemGroup>

</Project>
